{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    // Strudel ships NO types, so its imports rely on the editor's ambient
    // declarations — and this program reaches editor SOURCE: `**/*.ts` sweeps in
    // tests/parity-corpus/*, which deep-import `../../../editor/src/ir/parseStrudel`
    // (the barrel drags gifenc/CJS into vite-node, hence the deep path). Those
    // files' own tsconfig is not consulted, so without this line every
    // `@strudel/*` import below them is an implicit `any` and `next build`
    // fails type-check while `tsc -p packages/editor` stays green — a Vercel-only
    // red, which is exactly how it was found (#903/#907).
    // Pointed at the editor's file rather than copied: one declaration, one place.
    "../editor/src/strudel.d.ts"
  ],
  "exclude": ["node_modules"]
}
